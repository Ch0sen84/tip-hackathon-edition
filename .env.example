# Copy to .env and fill in for TIP_MODE=live. Not needed for TIP_MODE=demo.

# "demo" (default) -> SyntheticDataAdapter over fixtures/*.json, no API key needed.
# "live"           -> LiveUWAdapter, needs UW_API_KEY below.
TIP_MODE=demo

# Unusual Whales API key (Authorization: Bearer <key>). Required for TIP_MODE=live.
UW_API_KEY=

# Optional UW-CLIENT-API-ID header value, if your UW account requires one.
UW_CLIENT_API_ID=

# Base URL for the UW API. Override only for testing against a mock server.
UW_BASE_URL=https://api.unusualwhales.com

# Comma-separated tickers LiveUWAdapter scans for Market Radar.
TIP_LIVE_WATCHLIST=SPY,QQQ,NVDA,TSLA

# Which host interface/port docker-compose publishes the app on.
# SAFE DEFAULT: 127.0.0.1 (loopback only -- reachable only from this
# machine, not your LAN or the internet). Leave this alone unless you
# specifically intend to reach the app from another device.
#   - To open it to your LAN on a specific interface IP, set BIND_HOST to
#     that interface's address (e.g. BIND_HOST=192.168.1.50) -- never set
#     BIND_HOST=0.0.0.0, which binds every interface including any public
#     one this machine might have.
#   - BIND_PORT defaults to 8000; change it only if 8000 is already taken.
# QA remediation D11 (incorrect claim fixed): the Settings UI's
# credential-management endpoints (save/test/remove a UW or AI key) DO
# require authentication -- every one of them is behind the X-TIP-Auth
# token check (see app/auth.py / README.md "Authentication"). This
# network-level binding is still your FIRST line of defense (don't
# expose the port further than you intend), but it is not the only one:
# a request without a valid X-TIP-Auth header gets a 401 regardless of
# where it came from. After deploying, run
# tools/check_deployment_binding.sh to verify the actual published binding
# matches what you intended (it fails loudly on an unexpected 0.0.0.0/::
# bind unless you explicitly set ALLOW_PUBLIC_BIND=1 first).
BIND_HOST=127.0.0.1
BIND_PORT=8000

# Where the local SQLite qualifying-days store lives. Created automatically.
TIP_DB_PATH=./data/tip_hackathon.db

# Where SyntheticDataAdapter looks for scenario_*.json fixtures.
TIP_FIXTURES_DIR=./fixtures

# Where the local settings/credential store (mode + saved keys) lives.
# Created automatically, gitignored. NEVER commit this file.
TIP_SETTINGS_PATH=./data/settings.json

# "rest" (default) -> REST-ported tool calls via UWRestClient (the
# fallback transport, no extra setup needed). "mcp" -> real MCP-protocol
# calls against UW's hosted https://api.unusualwhales.com/api/mcp server,
# via the isolated venv/subprocess in mcp_isolated/ (see README.md
# "Investigate with AI -> MCP transport" and mcp_isolated/requirements.txt
# for one-time setup). Any other value falls back to "rest".
INVESTIGATE_TRANSPORT=rest

# --- Local Mode / Network Mode (Fetch Metadata auth redesign) ----------
#
# Local Mode: the DEFAULT loopback-only install's zero-token same-origin
# bypass -- a genuine browser on this machine works with NO token/
# pairing/banner at all. Network Mode: the pre-existing, completely
# unmodified X-TIP-Auth bootstrap/pairing-code token model (see
# "Authentication (Phase A)" below), used whenever this deployment is
# anything other than genuinely loopback-only.
#
# Leave this UNSET ("auto", the default) for every normal install --
# Local Mode activates automatically iff BIND_HOST above is loopback
# (127.0.0.1/::1/localhost), Network Mode otherwise. This is a
# zero-config, backward-compatible default: every existing install's
# behavior is unchanged unless BIND_HOST is already loopback, in which
# case mutating routes now also accept a genuine same-origin browser
# request with no token (see require_auth() in app/main.py).
#
# BIND_HOST is read here as your STATED INTENT ONLY -- this process
# cannot verify from inside a container that a loopback-looking
# BIND_HOST genuinely means nothing but this machine can reach the
# port. Do NOT combine Local Mode with ANY of the following -- none of
# them are supported, and Local Mode's trust model assumes they are not
# present:
#   * a custom docker-compose.override.yml (or any other Compose
#     override) that republishes/changes the port mapping
#   * a reverse proxy (nginx/Caddy/Traefik/etc.) in front of this app
#   * a tunnel (ngrok, cloudflared, Tailscale Funnel, or similar)
#   * any other mechanism that makes this port reachable from anywhere
#     but the literal machine Docker is running on
# If you need any of the above, either switch to Network Mode
# (TIP_LOCAL_MODE=0) and rely on the existing token model, or
# independently enforce authenticated access at that outer layer
# yourself -- Local Mode provides NO protection once a non-loopback path
# to this port exists, by design (it never claims to verify the
# network, only to trust what you told it via BIND_HOST).
#
# Set TIP_LOCAL_MODE=0 to force Network Mode's token model everywhere,
# even on a loopback-bound install. Set TIP_LOCAL_MODE=1 to explicitly
# assert Local Mode -- doing so against a non-loopback BIND_HOST makes
# this app REFUSE TO START (loud failure, never a silent downgrade);
# see backend/app/core/local_mode.py.
# TIP_LOCAL_MODE=auto

# Set to 1/true to render the Settings page in explanatory-only mode for a
# later public static demo build: Live Mode/credential inputs are hidden
# and live-mode switching is also blocked server-side. Leave unset/0 for
# the normal local/Docker edition.
PUBLIC_DEMO=0

# --- Phase A: CORS / Host hardening -----------------------------------
#
# This is a same-origin SPA (the frontend is served BY this backend, not
# a separate origin) -- CORS/Host are both locked to ONE origin derived
# from BIND_HOST/BIND_PORT above by default. Only set these explicitly if
# you are fronting this app with a reverse proxy under a different
# hostname than BIND_HOST (e.g. a domain name) -- otherwise leave unset.
# ALLOWED_ORIGIN=http://127.0.0.1:8000
# ALLOWED_HOST=127.0.0.1

# --- Phase A: authentication --------------------------------------------
#
# A random access token is generated on first run and persisted to
# TIP_AUTH_TOKEN_PATH (default: a ".auth_token" file next to
# TIP_SETTINGS_PATH above -- i.e. inside the same already-mounted
# persistent volume). Every state-changing/paid API call requires this
# token in an X-TIP-Auth header. A browser on the SAME machine as this
# backend can self-serve it automatically (GET /api/auth/bootstrap, which
# only ever answers a loopback caller) -- no action needed for the normal
# localhost/Docker-Desktop case. See README.md "Authentication" for the
# LAN/remote retrieval instructions and the HTTPS/reverse-proxy
# recommendation for any non-localhost deployment.
# TIP_AUTH_TOKEN_PATH=./data/.auth_token

# --- Phase A: storage-guard circuit breaker -----------------------------
#
# Pauses NEW writes (never deletes anything) when the volume's real free
# disk space drops below these thresholds. Background-job writes
# (Phase B) pause MUCH earlier (more conservatively) than on-demand
# writes, so a user actively using the app is never blocked by their own
# background collector.
# TIP_STORAGE_GUARD_ONDEMAND_MIN_MB=500
# TIP_STORAGE_GUARD_BACKGROUND_MIN_MB=2048

# --- QA remediation D9: scheduler + UW concurrency configuration -------
#
# These were already read from the environment by the app code, but
# docker-compose.yml never forwarded them into the container -- so
# setting them here previously had NO EFFECT on a real Docker deployment
# (only the hardcoded code-level defaults ever applied). Fixed this
# round: docker-compose.yml now passes all of these through.
#
# Market-wide Discovery scheduler (see README "Market-wide Discovery
# scheduler" section for the full mode explanation: disabled/dry_run/
# enabled). TIP_SCHEDULER_TOP_N supports a safe minimum of 1.
# TIP_SCHEDULER_TOP_N=5
# TIP_SCHEDULER_INTERVAL_S=900
# TIP_SCHEDULER_LEASE_TTL_S=90
# TIP_SCHEDULER_POLL_S=20
#
# UW's real concurrency ceiling is 3 simultaneous requests (confirmed
# live) -- this app's own default stays ONE below that (2), shared
# across every call path (manual Radar/Discovery/Ticker Analysis AND the
# scheduler) via one process-wide gate. Do not raise this above 2 unless
# you have independently re-verified UW's real ceiling for your account.
# TIP_UW_MAX_CONCURRENT_REQUESTS=2

# NOTE: the optional "Investigate with AI" feature's LLM provider key
# (Anthropic or OpenAI) has NO .env/environment-variable equivalent by
# design -- it is configured only through the running app's own Settings
# UI/API (POST /api/settings/ai-key), which writes it server-side to
# TIP_SETTINGS_PATH above, the same place the UW key is stored. There is
# intentionally no ANTHROPIC_API_KEY/OPENAI_API_KEY variable to set here.
# Without an AI key configured, Investigate with AI always serves the
# clearly-labeled static simulated transcript; the rest of the app
# (Market Radar, Ticker Analysis, Settings) is fully functional regardless.
